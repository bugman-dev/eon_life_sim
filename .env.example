# Copy to .env and replace the placeholders. .env stays untracked.
# Local npm commands use localhost. Docker Compose points the server container at the db service.

NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
POSTGRES_USER=life_sim
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=life_sim
DATABASE_URL=postgresql://life_sim:replace_me@localhost:5432/life_sim
WEB_PORT=5173
VITE_WS_URL=ws://localhost:3000/ws
TICK_INTERVAL_MS=1000
TICK_RATE=1
TICK_GAME_SECONDS=3600
PERSIST_EVERY_TICKS=5
WORLD_WIDTH=128
WORLD_HEIGHT=128
LOG_LEVEL=info
